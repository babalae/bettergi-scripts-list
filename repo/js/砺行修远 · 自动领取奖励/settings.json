      "F5快捷键",
      "ESC菜单"
    ],
    "default": "F5快捷键"
  },
  {
    "name": "clickDelayMs",
    "type": "input-text",
    "label": "每次点击后等待(毫秒)",
    "default": "900"
  },
  {
    "type": "separator"
  },
  {
    "name": "tierNames",
    "type": "input-text",
    "label": "1/8→8/8 每档奖励名（分号隔开，用于点完自检）",
    "default": "精锻用魔矿;智识之冕;大英雄的经验;祝圣之霜;摩拉;启圣之尘;祝圣精华;命之座"
  },
  {
    "name": "nodeCoords",
