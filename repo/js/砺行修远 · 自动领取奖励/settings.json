[
  {
    "type": "separator"
  },
  {
    "name": "enableWeekdayLimit",
    "type": "checkbox",
    "label": "只在勾选的星期执行（不勾则每天都执行）",
    "default": true
  },
  {
    "name": "runWeekdays",
    "type": "multi-checkbox",
    "label": "允许执行的星期（必须勾上上面的开关才生效）",
    "options": [
      "周一",
      "周二",
      "周三",
      "周四",
      "周五",
      "周六",
      "周日"
    ],
    "default": [
      "周一",
      "周四"
    ]
  },
  {
    "type": "separator"
  },
  {
    "name": "useManualProgress",
    "type": "checkbox",
    "label": "使用手动指定的进度（不打勾=自动图像识别 几/8）",
    "default": false
  },
  {
    "name": "manualProgress",
    "type": "input-text",
    "label": "手动进度（填 0~8 的数字，仅上面打勾时使用）",
    "default": "4"
  },
  {
    "type": "separator"
  },
  {
    "name": "openMenuAutomatically",
    "type": "checkbox",
    "label": "自动打开活动一览（关闭则需手动停在砺行修远页）",
    "default": true
  },
  {
    "name": "entryMode",
    "type": "select",
    "label": "活动一览打开方式",
