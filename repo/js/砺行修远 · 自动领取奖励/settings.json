  },
  {
    "name": "giftChestX",
    "type": "input-text",
    "label": "砺行复礼宝箱 X（8/8 按 ESC 后第二次点击）",
    "default": "575"
  },
  {
    "name": "giftChestY",
    "type": "input-text",
    "label": "砺行复礼宝箱 Y（8/8 按 ESC 后第二次点击）",
    "default": "790"
  },
  {
    "type": "separator"
  },
  {
    "name": "uidClickX",
    "type": "input-text",
    "label": "关弹窗用的 UID 区域 X（右下角）",
