[
  {
    "name": "timesValue",
    "type": "input-text",
    "label": "刷取次数",
    "default": "12"
  },
  {
    "name": "country",
    "type": "select",
    "label": "国家地区",
    "options": [
      "蒙德",
      "璃月",
      "稻妻",
      "须弥",
      "枫丹",
      "纳塔",
      "挪德卡莱",
      "至冬（暂未更新）"
    ],
    "default": "挪德卡莱"
  },
  {
    "name": "leyLineOutcropType",
    "type": "select",
    "label": "地脉花类型",
    "options": [
      "启示之花",
      "藏金之花"
    ],
    "default": "启示之花"
  },
  {
    "name": "isResinExhaustionMode",
    "type": "checkbox",
    "label": "树脂耗尽模式",
    "default": false
  },
  {
    "name": "openModeCountMin",
    "type": "checkbox",
    "label": "耗尽模式取小值",
    "default": true
  },
  {
    "name": "onlySurgeMode",
    "type": "checkbox",
    "label": "仅有双倍时刷取地脉花",
    "default": false
  },
  {
    "name": "team",
    "type": "input-text",
    "label": "战斗队伍名称",
    "default": ""
  },
  {
    "name": "friendshipTeam",
    "type": "input-text",
    "label": "好感队伍名称（可选）",
    "default": ""
  },
  {
    "name": "timeout",
    "type": "input-text",
    "label": "战斗超时时间（秒）",
    "default": "120"
  },
  {
    "name": "isGoToSynthesizer",
    "type": "checkbox",
    "label": "前往合成台合成浓缩树脂",
    "default": false
  },
  {
    "name": "useFragileResin",
    "type": "checkbox",
    "label": "使用脆弱树脂",
    "default": false
  },
  {
    "name": "useTransientResin",
    "type": "checkbox",
    "label": "使用须臾树脂",
    "default": false
  },
  {
    "name": "isNotification",
    "type": "checkbox",
    "label": "发送详细通知",
    "default": true
  },
  {
    "name": "useAdventurerHandbook",
    "type": "checkbox",
    "label": "使用冒险之证寻找地脉花",
    "default": true
  }
]